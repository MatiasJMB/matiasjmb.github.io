---
import Base from '../layouts/Base.astro';
import { rutaInicio, t } from '../i18n/ui';
---

<Base lang="es" titulo={`${t('es', 'noEncontradoTitulo')} · ${t('es', 'marca')}`} descripcion={t('es', 'noEncontradoTexto')}>
  <section class="vacio contenedor">
    <h1>{t('es', 'noEncontradoTitulo')}</h1>
    <p class="medida">{t('es', 'noEncontradoTexto')}</p>
    <p><a class="boton" href={rutaInicio('es')}>{t('es', 'noEncontradoVolver')}</a></p>
  </section>
</Base>
