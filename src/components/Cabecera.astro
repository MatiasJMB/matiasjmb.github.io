---
import { CV } from '../data/contacto';
import { rutaInicio, t, type Lang } from '../i18n/ui';
import BotonTema from './BotonTema.astro';
import Logo from './Logo.astro';
import SelectorIdioma from './SelectorIdioma.astro';

interface Props {
  lang: Lang;
  alternas: Record<Lang, string>;
}
const { lang, alternas } = Astro.props;
const inicio = rutaInicio(lang);
const anclas = [
  { href: `${inicio}#proyectos`, seccion: 'proyectos', texto: t(lang, 'menuProyectos') },
  { href: `${inicio}#experiencia`, seccion: 'experiencia', texto: t(lang, 'menuExperiencia') },
  { href: `${inicio}#contacto`, seccion: 'contacto', texto: t(lang, 'menuContacto') },
];
---

<header class="cabecera">
  <div class="contenedor cabecera-fila">
    <div class="cabecera-izq">
      <a class="cabecera-marca" href={inicio}><Logo /><span class="solo" translate="no">{t(lang, 'marca')}</span></a>
      <nav class="cabecera-nav" aria-label={t(lang, 'menuEtiqueta')}>
        {anclas.map((a) => <a class="cabecera-ancla" href={a.href} data-seccion={a.seccion}>{a.texto}</a>)}
        <a href={CV} target="_blank" rel="noopener">{t(lang, 'menuCv')}</a>
        <span class="nav-indicador" aria-hidden="true"></span>
      </nav>
    </div>
    <div class="cabecera-lado">
      <SelectorIdioma lang={lang} alternas={alternas} />
      <BotonTema lang={lang} />
    </div>
  </div>
</header>
