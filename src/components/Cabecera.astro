---
import { CV } from '../data/contacto';
import { rutaInicio, t, type Lang } from '../i18n/ui';
import BotonTema from './BotonTema.astro';
import Logo from './Logo.astro';
import SelectorIdioma from './SelectorIdioma.astro';

interface Props {
  lang: Lang;
  alternas: Record<Lang, string>;
}
const { lang, alternas } = Astro.props;
const inicio = rutaInicio(lang);
const anclas = [
  { href: `${inicio}#proyectos`, texto: t(lang, 'menuProyectos') },
  { href: `${inicio}#experiencia`, texto: t(lang, 'menuExperiencia') },
  { href: `${inicio}#contacto`, texto: t(lang, 'menuContacto') },
];
---

<header class="cabecera">
  <div class="contenedor cabecera-fila">
    <a class="cabecera-marca" href={inicio}><Logo /><span translate="no">{t(lang, 'marca')}</span></a>
    <div class="cabecera-lado">
      <nav class="cabecera-anclas" aria-label={t(lang, 'menuEtiqueta')}>
        {anclas.map((a) => <a href={a.href}>{a.texto}</a>)}
      </nav>
      <a class="cabecera-cv" href={CV} target="_blank" rel="noopener">{t(lang, 'menuCv')}</a>
      <SelectorIdioma lang={lang} alternas={alternas} />
      <BotonTema lang={lang} />
    </div>
  </div>
</header>
