---
import { CV, GITHUB, LINKEDIN } from '../data/contacto';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<footer class="pie">
  <div class="contenedor pie-fila">
    <p>{t(lang, 'legal')}</p>
    <nav aria-label={t(lang, 'pieEtiqueta')}>
      <a href={GITHUB} rel="noopener">GitHub</a>
      <a href={LINKEDIN} rel="noopener">LinkedIn</a>
      <a href={CV} target="_blank" rel="noopener">CV</a>
    </nav>
  </div>
</footer>
