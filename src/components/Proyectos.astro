---
import { t, type Lang } from '../i18n/ui';
import type { Proyecto } from '../lib/proyectos';
import Tarjeta from './Tarjeta.astro';

interface Props {
  lang: Lang;
  proyectos: Proyecto[];
}
const { lang, proyectos } = Astro.props;

const tecnologias = [
  ['node', 'Node.js'],
  ['react', 'React'],
  ['mysql', 'MySQL'],
  ['supabase', 'Supabase'],
  ['aws', 'AWS'],
  ['python', 'Python'],
] as const;

// Solo aparecen los filtros que usa al menos un proyecto.
const usadas = new Set(proyectos.flatMap((p) => p.data.filtros));
const filtros = tecnologias.filter(([clave]) => usadas.has(clave));
---

<section id="proyectos" class="seccion contenedor" aria-labelledby="proyectos-titulo">
  <h2 id="proyectos-titulo" data-entra>{t(lang, 'proyectosTitulo')}</h2>

  <div class="filtro" role="group" aria-label={t(lang, 'filtroEtiqueta')} hidden data-filtro-fila data-entra>
    <button type="button" data-filtro="todos" aria-pressed="true">{t(lang, 'filtroTodos')}</button>
    {filtros.map(([clave, nombre]) => <button type="button" data-filtro={clave} aria-pressed="false">{nombre}</button>)}
  </div>
  <p
    class="solo"
    aria-live="polite"
    data-conteo
    data-uno={t(lang, 'conteoUno')}
    data-varios={t(lang, 'conteoVarios')}
  ></p>

  <div class="grilla">
    {proyectos.map((p, i) => <Tarjeta lang={lang} proyecto={p} prioridad={i < 2} />)}
  </div>
</section>
