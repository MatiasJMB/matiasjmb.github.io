---
import { CORREO, GITHUB, GITHUB_TEXTO, LINKEDIN, LINKEDIN_TEXTO, TELEFONO, TELEFONO_HREF } from '../data/contacto';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const correo = `mailto:${CORREO}?subject=${encodeURIComponent(t(lang, 'contactoAsunto'))}`;
const filas = [
  { etiqueta: t(lang, 'contactoCorreo'), href: `mailto:${CORREO}`, texto: CORREO, externo: false },
  { etiqueta: t(lang, 'contactoTelefono'), href: TELEFONO_HREF, texto: TELEFONO, externo: false },
  { etiqueta: t(lang, 'contactoLinkedin'), href: LINKEDIN, texto: LINKEDIN_TEXTO, externo: true },
  { etiqueta: t(lang, 'contactoGithub'), href: GITHUB, texto: GITHUB_TEXTO, externo: true },
];
---

<section id="contacto" class="seccion" aria-labelledby="contacto-titulo">
  <h2 id="contacto-titulo" data-entra>{t(lang, 'contactoTitulo')}</h2>
  <p class="medida" data-entra>{t(lang, 'contactoFrase')}</p>
  <p class="contacto-boton" data-entra>
    <a class="boton" href={correo}>{t(lang, 'contactoBoton')}</a>
  </p>
  <dl class="datos">
    {
      filas.map((f) => (
        <div class="dato" data-entra>
          <dt>{f.etiqueta}</dt>
          <dd><a class="enlace" href={f.href} rel={f.externo ? 'noopener' : undefined}>{f.texto}</a></dd>
        </div>
      ))
    }
  </dl>
</section>
