---
import { CV, GITHUB, LINKEDIN } from '../data/contacto';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<section class="hero contenedor" aria-labelledby="hero-titulo">
  <h1 id="hero-titulo">{t(lang, 'marca')}</h1>
  <p class="lead">{t(lang, 'heroLead')}</p>
  <p class="medida">{t(lang, 'heroTexto')}</p>
  <div class="hero-acciones">
    <a class="boton" href="#proyectos">{t(lang, 'verProyectos')}</a>
    <a class="enlace" href={CV} target="_blank" rel="noopener">{t(lang, 'enlaceCv')}</a>
    <a class="enlace" href={GITHUB} rel="noopener">{t(lang, 'enlaceGithub')}</a>
    <a class="enlace" href={LINKEDIN} rel="noopener">{t(lang, 'enlaceLinkedin')}</a>
  </div>
  <p class="hero-nota">{t(lang, 'heroDisponible')}</p>
</section>
