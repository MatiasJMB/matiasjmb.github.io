---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { rutaInicio, rutaProyecto, slugDe, t, type Lang } from '../i18n/ui';
import { capturaDe, proyectosDe, type Proyecto } from '../lib/proyectos';

interface Props {
  lang: Lang;
  entry: Proyecto;
}
const { lang, entry } = Astro.props;
const d = entry.data;
const slug = slugDe(entry.id);

const lista = await proyectosDe(lang);
const otra = await proyectosDe(lang === 'es' ? 'en' : 'es');
const posicion = Math.max(0, lista.findIndex((p) => p.id === entry.id));
const siguiente = lista.length > 1 ? lista[(posicion + 1) % lista.length] : undefined;

// Si la ficha existe en el otro idioma, el selector apunta a ella; si no, al inicio.
const hayOtra = otra.some((p) => slugDe(p.id) === slug);
const alternas = {
  es: lang === 'es' ? rutaProyecto('es', slug) : hayOtra ? rutaProyecto('es', slug) : rutaInicio('es'),
  en: lang === 'en' ? rutaProyecto('en', slug) : hayOtra ? rutaProyecto('en', slug) : rutaInicio('en'),
};

const { Content } = await render(entry);
const captura = capturaDe(entry);
const alt = t(lang, 'altCaptura').replace('{titulo}', d.titulo);
// Un título largo baja a --step-head para no pasar de dos líneas.
const tituloLargo = d.titulo.length > 34;
---

<Base lang={lang} titulo={`${d.titulo} · ${t(lang, 'marca')}`} descripcion={d.resumen} alternas={alternas}>
  <article class="ficha contenedor">
    <h1 class:list={['ficha-titulo', { largo: tituloLargo }]} data-entra>{d.titulo}</h1>
    <p class="lead medida" data-entra>{d.resumen}</p>

    <dl class="def" data-entra>
      <div>
        <dt>{t(lang, 'defCliente')}</dt>
        <dd>{d.cliente}</dd>
      </div>
      <div>
        <dt>{t(lang, 'defRol')}</dt>
        <dd>{d.rol}</dd>
      </div>
      <div>
        <dt>{t(lang, 'defPeriodo')}</dt>
        <dd>{d.periodo}</dd>
      </div>
      <div>
        <dt>{t(lang, 'defStack')}</dt>
        <dd>{d.stack.join(' · ')}</dd>
      </div>
    </dl>

    {
      (d.repo || d.demo || d.privado) && (
        <div class="ficha-acciones" data-entra>
          {d.repo && <a class="boton" href={d.repo} rel="noopener">{t(lang, 'verCodigo')}</a>}
          {d.demo && <a class="enlace" href={d.demo} rel="noopener">{t(lang, 'verDemo')}</a>}
          {d.privado && <p class="ficha-privado">{t(lang, 'privado')}</p>}
        </div>
      )
    }

    {
      captura && (
        <div class="mat ficha-mat" data-entra>
          <img
            src={captura.src}
            srcset={captura.srcset}
            sizes="(max-width:1080px) 100vw, 1032px"
            width="1920"
            height="1200"
            alt={alt}
            loading="eager"
            decoding="async"
          />
        </div>
      )
    }

    <div class="prosa">
      <Content />
    </div>

    <nav class="ficha-pie" aria-label={t(lang, 'navProyectos')} data-entra>
      <a class="ficha-volver" href={`${rutaInicio(lang)}#proyectos`}>{t(lang, 'volver')}</a>
      {
        siguiente && (
          <a class="siguiente" href={rutaProyecto(lang, slugDe(siguiente.id))}>
            <span>{t(lang, 'siguiente')}</span> <strong>{siguiente.data.titulo}</strong> →
          </a>
        )
      }
    </nav>
  </article>
</Base>
