---
import { render } from 'astro:content';
import { altFoto } from '../data/creditos';
import Base from '../layouts/Base.astro';
import { rutaInicio, rutaProyecto, slugDe, t, type Lang } from '../i18n/ui';
import { capturaDe, imagenFicha, proyectosDe, type Proyecto } from '../lib/proyectos';
import Fija from './Fija.astro';

interface Props {
  lang: Lang;
  entry: Proyecto;
}
const { lang, entry } = Astro.props;
const d = entry.data;
const slug = slugDe(entry.id);

const lista = await proyectosDe(lang);
const otra = await proyectosDe(lang === 'es' ? 'en' : 'es');
const posicion = Math.max(0, lista.findIndex((p) => p.id === entry.id));
const siguiente = lista.length > 1 ? lista[(posicion + 1) % lista.length] : undefined;

// Si la ficha existe en el otro idioma, el selector apunta a ella; si no, al inicio.
const hayOtra = otra.some((p) => slugDe(p.id) === slug);
const alternas = {
  es: lang === 'es' ? rutaProyecto('es', slug) : hayOtra ? rutaProyecto('es', slug) : rutaInicio('es'),
  en: lang === 'en' ? rutaProyecto('en', slug) : hayOtra ? rutaProyecto('en', slug) : rutaInicio('en'),
};

const { Content } = await render(entry);
const imagen = imagenFicha(entry, posicion);
const esCaptura = capturaDe(entry) !== null;
const alt = esCaptura ? d.titulo : altFoto(imagen, lang);
---

<Base lang={lang} titulo={`${d.titulo} · ${t(lang, 'marca')}`} descripcion={d.resumen} alternas={alternas}>
  <article class="seccion ficha">
    <a class="enlace ficha-volver" href={`${rutaInicio(lang)}#proyectos`}>{t(lang, 'volver')}</a>
    <h1 class="tit" data-reveal>{d.titulo}</h1>
    <p class="lead" data-reveal>{d.resumen}</p>

    <dl class="def" data-reveal>
      <dt>{t(lang, 'defCliente')}</dt>
      <dd>{d.cliente}</dd>
      <dt>{t(lang, 'defRol')}</dt>
      <dd>{d.rol}</dd>
      <dt>{t(lang, 'defPeriodo')}</dt>
      <dd>{d.periodo}</dd>
      <dt>{t(lang, 'defStack')}</dt>
      <dd>{d.stack.join(', ')}</dd>
    </dl>

    {
      (d.repo || d.demo) && (
        <div class="ficha-botones">
          {d.repo && <a class="boton" href={d.repo} rel="noopener">{t(lang, 'verCodigo')}</a>}
          {d.demo && <a class="boton" href={d.demo} rel="noopener">{t(lang, 'verDemo')}</a>}
        </div>
      )
    }
    {d.privado && <p class="ficha-privado">{t(lang, 'privado')}</p>}

    <div class="prosa">
      <Content />
    </div>

    {
      siguiente && (
        <a class="siguiente" href={rutaProyecto(lang, slugDe(siguiente.id))}>
          {t(lang, 'siguiente')}
        </a>
      )
    }
  </article>
  <Fija slot="fija" imagenes={[{ src: imagen, alt, captura: esCaptura }]} activa={imagen} />
</Base>
