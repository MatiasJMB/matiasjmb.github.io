---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<button type="button" class="tema" role="switch" aria-checked="false" aria-label={t(lang, 'temaEtiqueta')} data-tema>
  <span class="tema-pulgar">
    <svg class="tema-sol" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4.2"></circle>
      <g>
        <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"></path>
      </g>
    </svg>
    <svg class="tema-luna" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20.2 14.6A8.3 8.3 0 0 1 9.4 3.8a8.3 8.3 0 1 0 10.8 10.8Z"></path>
    </svg>
  </span>
</button>
